# ── AED Inspection CV Service — Environment Template ────────────────────────
# Copy to .env and fill in your values.
# Never commit .env to version control.
# Used only when running the service directly (uvicorn) outside Docker —
# docker-compose injects these same variables via docker-compose.yml instead.

DEBUG=false
LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=python_cv_service_secret_key_change_in_production_xyz789

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=aed_inspection

# ── Gemini Vision ─────────────────────────────────────────────────────────────
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Backend Node.js service URL (for callbacks) ───────────────────────────────
BACKEND_URL=http://localhost:3000
