# ── AED Inspection Platform — Environment Template ──────────────────────────
# Copy to .env and fill in your values.
# Never commit .env to version control.

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_PASSWORD=change_this_strong_password_in_production

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=minimum_32_chars_random_secret_change_in_production_abc123
SECRET_KEY=python_cv_service_secret_key_change_in_production_xyz789

# ── Gemini Vision ─────────────────────────────────────────────────────────────
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Outbound email (public inspection report delivery) ─────────────────────────
# Any standard SMTP account works (Gmail app password, SendGrid, Mailgun, etc).
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AED Inspection Platform <no-reply@aedsmartx.com>"
# Every completed public inspection report is also sent here.
REPORT_BCC_EMAIL=aedsmartx@gmail.com

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API. If the frontend is
# deployed on Vercel at inspector.aedsmartx.com, set this to that URL.
CORS_ORIGINS=http://localhost:3000,https://inspector.aedsmartx.com

# ── Production backend deploy (docker-compose.prod.yml) ─────────────────────
# The API subdomain Caddy will request an HTTPS cert for, e.g. api.aedsmartx.com
DOMAIN=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Local dev: http://localhost:3001. On Vercel, set this in the Vercel project's
# env vars to your deployed backend's public URL, e.g. https://api.aedsmartx.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
